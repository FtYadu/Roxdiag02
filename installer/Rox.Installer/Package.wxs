<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 MSI for the ROX Offline Diagnostic Suite. Installs the self-contained WPF app plus the default
  R11_Oversea data package to Program Files\ROXDiagnostic, adds Start-menu shortcuts, and supports
  clean major-upgrade. No auto-update / network components (offline guarantee, PRD §14).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ROX Offline Diagnostic Suite"
           Manufacturer="ROX Diagnostic Tools"
           Version="2.0.0.0"
           UpgradeCode="8C4B2E90-6C2A-4E5C-9E4C-2B0F1E0A1C22"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ROX Offline Diagnostic Suite is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install to Program Files\ROXDiagnostic -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ROXDiagnostic" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="ROX Diagnostic" />
    </StandardDirectory>

    <Feature Id="Main" Title="ROX Offline Diagnostic Suite" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <!-- Start-menu shortcut to the installed executable -->
    <Component Id="AppShortcut" Directory="AppShortcutFolder" Guid="B3F8A1D2-9C77-4A2E-8B10-2E7A9C4D5E60">
      <Shortcut Id="StartMenuShortcut"
                Name="ROX Offline Diagnostic Suite"
                Target="[INSTALLFOLDER]ROXDiagnostic.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ROXDiagnostic" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Package>

  <!-- Harvest the entire self-contained publish output (app + bundled data/) -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
