<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ROXDiagnostic</AssemblyName>
    <RootNamespace>Rox.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rox.Core/Rox.Core.csproj" />
    <ProjectReference Include="../Rox.Profile/Rox.Profile.csproj" />
    <ProjectReference Include="../Rox.FlowEngine/Rox.FlowEngine.csproj" />
    <ProjectReference Include="../Rox.Simulator/Rox.Simulator.csproj" />
    <ProjectReference Include="../Rox.Transport/Rox.Transport.csproj" />
    <ProjectReference Include="../Rox.Uds/Rox.Uds.csproj" />
    <ProjectReference Include="../Rox.Diagnostics/Rox.Diagnostics.csproj" />
    <ProjectReference Include="../Rox.Security/Rox.Security.csproj" />
    <ProjectReference Include="../Rox.KeyFunctions/Rox.KeyFunctions.csproj" />
    <ProjectReference Include="../Rox.Reflash/Rox.Reflash.csproj" />
    <ProjectReference Include="../Rox.Logging/Rox.Logging.csproj" />
  </ItemGroup>

  <!-- Bundle the default R11_Oversea data package (profile + flow XMLs) with the app. -->
  <ItemGroup>
    <None Include="..\..\data\**\*.*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
