<UserControl x:Class="Rox.App.Views.KeyFunctionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Immobilizer Key Functions" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="ECU:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="140" ItemsSource="{Binding Ecus}" SelectedItem="{Binding SelectedEcu}" Margin="0,0,12,0" />
      <Button Content="Read key count" Command="{Binding ReadCountCommand}" Margin="0,0,8,0" />
      <Button Content="Pair new key" Command="{Binding PairCommand}" Margin="0,0,8,0" />
      <Button Content="Duplicate key" Command="{Binding DuplicateCommand}" Margin="0,0,8,0" />
      <Button Content="Delete key" Command="{Binding DeleteCommand}" />
    </WrapPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Current key count: " Opacity="0.7" VerticalAlignment="Center" />
      <TextBlock Text="{Binding KeyCount}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
    </StackPanel>

    <Border Grid.Row="3" CornerRadius="6" Padding="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Audit trail" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding AuditLog}" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                 Background="Transparent" BorderThickness="0" />
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" Opacity="0.85" TextWrapping="Wrap" />
  </Grid>
</UserControl>
