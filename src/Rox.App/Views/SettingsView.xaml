<UserControl x:Class="Rox.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

      <TextBlock Text="Transport" FontWeight="SemiBold" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding TransportKinds}" SelectedItem="{Binding TransportKind}" Margin="0,0,0,12" />

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="DoIP host" Opacity="0.7" />
          <TextBox Text="{Binding DoipHost}" Margin="0,0,0,8" />
          <TextBlock Text="DoIP port" Opacity="0.7" />
          <TextBox Text="{Binding DoipPort}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Text="CAN baudrate" Opacity="0.7" />
          <TextBox Text="{Binding Baudrate}" Margin="0,0,0,8" />
          <TextBlock Text="Timeout (s)" Opacity="0.7" />
          <TextBox Text="{Binding TimeoutSeconds}" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Reflash min. voltage (V)" Opacity="0.7" />
      <TextBox Text="{Binding MinReflashVoltage}" Margin="0,0,0,12" />

      <TextBlock Text="Data package directory" FontWeight="SemiBold" Margin="0,0,0,4" />
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding DataPackageDirectory}" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseDataPackageCommand}" />
      </Grid>

      <TextBlock Text="Seed-key module (user-supplied)" FontWeight="SemiBold" Margin="0,0,0,4" />
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding SecurityModulePath}" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseModuleCommand}" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Test" Command="{Binding TestModuleCommand}" />
      </Grid>
      <TextBlock Text="{Binding ModuleProtection}" Opacity="0.6" FontSize="12" Margin="0,0,0,12" />

      <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,16" />

      <Button Content="Save settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Status}" Margin="0,10,0,0" Opacity="0.85" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
